# ============================================================
#  Taekwondo Evaluation System – Variables de entorno
#  Copia este archivo a .env y ajusta los valores
#  Uso:  cp .env.example .env
# ============================================================

# --- Puertos ---
FRONTEND_PORT=4000
BACKEND_PORT=8001

# --- Base de datos ---
DATABASE_URL=sqlite:////data/taekwondo.db

# --- Restart policy ---
# Opciones: no | always | on-failure | unless-stopped
RESTART_POLICY=unless-stopped
